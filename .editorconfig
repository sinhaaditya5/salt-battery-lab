root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{c,h}]
indent_size = 4

# Generated data and native CAD/EDA files: never reformat
[{**/out/**,**/runs*/**,*.kicad_*,*.net,*.gbr,*.drl,*.step,*.stl,*.dxf,*.UPF}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
