text {"at": [10.0, 35.0], "text": "1. ASSEMBLE DISCHARGED (NaCl + Fe) IN Ar GLOVEBOX, H2O/O2 < 1 ppm. NO SODIUM METAL IS HANDLED AT ASSEMBLY.", "height": 1.1, "justify": "L", "rotation": 0.0}
layer.current {"name": "TEXT"}
text {"at": [10.0, 33.0], "text": "2. GENERAL TOLERANCES ISO 2768-mK. SEALING FACES (ITEMS 2,5,12) FLATNESS 0.02, Ra 0.8.", "height": 1.1, "justify": "L", "rotation": 0.0}
layer.current {"name": "TEXT"}
text {"at": [10.0, 31.0], "text": "3. OPERATE 180-260 C; HEAT/COOL <= 2 C/min; HW TRIP 290 C.", "height": 1.1, "justify": "L", "rotation": 0.0}
layer.current {"name": "TEXT"}
text {"at": [10.0, 29.0], "text": "4. CELL LIMITS 1.8-2.75 V; TRIPS 1.65/2.95 V (SIDE REACTIONS 1.58/3.05 V).", "height": 1.1, "justify": "L", "rotation": 0.0}
layer.current {"name": "TEXT"}
text {"at": [10.0, 27.0], "text": "5. GASKET/SEAL MATERIALS ARE CANDIDATES - QT-02/03/04/07/08 MUST PASS BEFORE ANY CHARGED CELL.", "height": 1.1, "justify": "L", "rotation": 0.0}
layer.current {"name": "TEXT"}
