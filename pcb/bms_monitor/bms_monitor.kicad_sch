	(uuid "659a170e-d558-be7c-a0b3-67137bf1e9f7")
	(paper "A3")
	(title_block
		(title "Salt-Battery 16-ch BMS/monitor — Overview")
		(date "2026-11-02")
		(rev "A")
		(company "Salt-Battery-Lab (pre-prototype)")
		(comment 1 "CONCEPT – NOT FOR PRODUCTION")
		(comment 2 "rev A 2026-11-02, ratings from params/product_params.py (BMS)")
		(comment 3 "16 x 0-20 V isolated block channels, 8 NTC, +/-200 A shunt, H2 + pressure")
	)
	(lib_symbols)
	(text "CONCEPT – NOT FOR PRODUCTION.  rev A  2026-11-02.  Salt-Battery-Lab aqueous Na-ion (R1) 12 V monobloc string monitor."
		(exclude_from_sim no)
		(at 20 112 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "699c88f7-7c65-78fb-a434-bab424ba99c2")
	)
	(text "Ratings (params/product_params.py BMS): 16 series groups/board, 0-20 V per monobloc channel, 8 NTC, +/-200 A on 0.25 mOhm shunt,"
		(exclude_from_sim no)
		(at 20 117.4 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "d554fcb0-ca17-f72b-3077-e92199e0a32c")
	)
	(text "  2 gas inputs (H2 4-20 mA + pressure 0.5-4.5 V ratiometric), CAN 2.0B + RS-485 Modbus RTU, 2.5 kV isolation, supply 9-60 V."
		(exclude_from_sim no)
		(at 20 122.8 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "50eb4c68-4e41-5c6c-b050-528a4ab6a9bc")
	)
	(text "Cell-voltage approach: one isolated amplifier per 12 V monobloc (AMC3330, integrated isolated DC/DC) behind a 1 M / 30.1 k divider"
		(exclude_from_sim no)
		(at 20 128.2 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "c422e611-8d42-8f4a-51de-4644cf0d7bf2")
	)
	(text "  -> each channel floats at its own block potential, so the same board works anywhere in a 48 V module or a 480 V UPS string"
		(exclude_from_sim no)
		(at 20 133.6 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "5357b811-1a23-b37b-e8f8-4d434a2159bf")
	)
	(text "  (boards daisy-chain over isolated CAN). Li-ion AFEs (BQ79616, LTC6813...) assume 0-5 V per input in a common stack; an"
		(exclude_from_sim no)
		(at 20 139 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "e6c5711f-117f-9e56-d67a-1a4aab0e4b51")
	)
	(text "  aqueous R1 monobloc is 6-17.5 V (10 cells x 0.6-1.75 V) so they cannot read it directly, and per-cell use wastes channels."
		(exclude_from_sim no)
		(at 20 144.4 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "e02c756a-e8fb-5086-3394-0bb169f97115")
	)
	(text "Each block draws only ~17 uA (divider) -> no balancing load mismatch; AMC power (~29 mA typ each) comes from the board side."
		(exclude_from_sim no)
		(at 20 149.8 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "e88aa01b-eca1-2254-cfef-d24846d3e6dd")
	)
	(text "Isolation domains: HV islands CH01..CH16 + SH (6.4 mm min to logic), ICAN / I485 (3.2 mm min), enforced by DRC custom rules."
		(exclude_from_sim no)
		(at 20 155.2 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "7f3b935b-402b-9537-7d0c-dab99a258125")
	)
