	(lib_symbols)
	(text "CONCEPT – NOT FOR PRODUCTION. SCM-1 rev A 2026-11-02: S-cell R0 test monitor (Na-MCl2, 180-260 C)."
		(exclude_from_sim no)
		(at 20 80 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "4daff2f9-d493-c710-4dfa-9290a40aa545")
	)
	(text "Cell sense: 4 taps -> 100k/10k (0.1%) -> ADS131M08 adjacent-tap differential; FS 12.4 V string -> 1.127 V. Calibrate per channel (TP-E03)."
		(exclude_from_sim no)
		(at 20 85.4 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "41ba1305-f898-74f3-b460-50756363c8fa")
	)
	(text "Thermocouples MUST be ungrounded-junction (insulated): the cell case is at cell potential and the MAX31856 inputs are referenced to GND."
		(exclude_from_sim no)
		(at 20 90.8 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "588d49dc-4e78-b093-0e79-6772503266ca")
	)
	(text "Hardware interlock: heater SSR drive = HEAT_EN AND TC_FAULT_N (74LVC1G08). TC HI-fault thresholds are programmed to OPERATE.T_trip_C;"
		(exclude_from_sim no)
		(at 20 96.2 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "c6f8113e-6835-54cc-95f7-0a732a93aa8f")
	)
	(text "  an independent bimetal cut-out and the E-stop NC contact are wired in series with the SSR/mains OFF-BOARD (build manual step E-04)."
		(exclude_from_sim no)
		(at 20 101.6 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
		(uuid "148b01cf-d067-541f-c022-561576b75188")
	)
	(text "Cycler interlock K1 NO-COM closes only while firmware state is healthy; de-energised (open) at reset, brown-out or MCU hang (IWDG)."
		(exclude_from_sim no)
		(at 20 107 0)
		(effects
			(font (size 1.6 1.6))
			(justify left top)
		)
