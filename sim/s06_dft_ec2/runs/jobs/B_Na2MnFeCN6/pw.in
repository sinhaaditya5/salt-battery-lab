&CONTROL
  calculation = 'vc-relax'
  prefix = 'Na2MnFeCN6'
  outdir = './tmp'
  pseudo_dir = '/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 150
  disk_io = 'low'
  max_seconds = 160000
/
&SYSTEM
  ibrav = 0
  nat = 16
  ntyp = 5
  ecutwfc = 40.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 2
  starting_magnetization(1) = 0.0
  starting_magnetization(2) = 0.8
  starting_magnetization(3) = 0.0
  starting_magnetization(4) = 0.0
  starting_magnetization(5) = 0.0
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.3
  electron_maxstep = 250
  mixing_mode = 'plain'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
ATOMIC_SPECIES
  Na 22.99 na_pbe_v1.5.uspp.F.UPF
  Mn 54.938 mn_pbe_v1.5.uspp.F.UPF
  Fe 55.845 fe_pbe_v1.5.uspp.F.UPF
  C 12.011 c_pbe_v1.2.uspp.F.UPF
  N 14.007 n_pbe_v1.2.uspp.F.UPF
CELL_PARAMETERS angstrom
     -4.98941065    -4.98941065     0.00000000
     -4.98941065    -0.00000000    -4.98941065
      0.00000000    -4.98941065    -4.98941065
ATOMIC_POSITIONS angstrom
  Na    -7.48411598    -7.48411598    -7.48411598
  Na    -2.49470533    -2.49470533    -2.49470533
  Mn    -4.98941065    -4.98941065    -4.98941065
  Fe    -0.00000000    -0.00000000    -0.00000000
  C    -1.87235586    -4.98941065    -4.98941065
  C    -4.98941065    -8.10646544    -4.98941065
  C    -4.98941065    -1.87235586    -4.98941065
  C    -8.10646544    -4.98941065    -4.98941065
  C    -4.98941065    -4.98941065    -1.87235586
  C    -4.98941065    -4.98941065    -8.10646544
  N    -3.05576558    -4.98941065    -4.98941065
  N    -4.98941065    -6.92305572    -4.98941065
  N    -4.98941065    -3.05576558    -4.98941065
  N    -6.92305572    -4.98941065    -4.98941065
  N    -4.98941065    -4.98941065    -3.05576558
  N    -4.98941065    -4.98941065    -6.92305572
K_POINTS automatic
  3 3 3 0 0 0
HUBBARD {atomic}
  U Mn-3d 3.9
  U Fe-3d 5.3
