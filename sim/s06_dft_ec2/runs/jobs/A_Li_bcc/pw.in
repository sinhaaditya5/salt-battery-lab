&CONTROL
  calculation = 'vc-relax'
  prefix = 'Li_bcc'
  outdir = './tmp'
  pseudo_dir = '/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 150
  disk_io = 'low'
  max_seconds = 160000
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.3
  electron_maxstep = 250
  mixing_mode = 'plain'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
ATOMIC_SPECIES
  Li 6.94 li_pbe_v1.4.uspp.F.UPF
CELL_PARAMETERS angstrom
     -1.71822703    -1.71822703    -1.71822703
     -1.71822703     1.71822703     1.71822703
      1.71822703     1.71822703    -1.71822703
ATOMIC_POSITIONS angstrom
  Li     0.00000000     0.00000000     0.00000000
K_POINTS automatic
  22 22 22 0 0 0
