&CONTROL
  calculation = 'vc-relax'
  prefix = 'MnFeCN6'
  outdir = './tmp'
  pseudo_dir = '/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 150
  disk_io = 'low'
  max_seconds = 160000
/
&SYSTEM
  ibrav = 0
  nat = 14
  ntyp = 4
  ecutwfc = 40.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 2
  starting_magnetization(1) = 0.8
  starting_magnetization(2) = 0.0
  starting_magnetization(3) = 0.0
  starting_magnetization(4) = 0.0
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.3
  electron_maxstep = 250
  mixing_mode = 'plain'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
ATOMIC_SPECIES
  Mn 54.938 mn_pbe_v1.5.uspp.F.UPF
  Fe 55.845 fe_pbe_v1.5.uspp.F.UPF
  C 12.011 c_pbe_v1.2.uspp.F.UPF
  N 14.007 n_pbe_v1.2.uspp.F.UPF
CELL_PARAMETERS angstrom
     -4.93690554    -4.93690554     0.00000000
     -4.93690554    -0.00000000    -4.93690554
      0.00000000    -4.93690554    -4.93690554
ATOMIC_POSITIONS angstrom
  Mn    -4.93690554    -4.93690554    -4.93690554
  Fe    -0.00000000    -0.00000000    -0.00000000
  C    -1.87127171    -4.93690554    -4.93690554
  C    -4.93690554    -8.00253937    -4.93690554
  C    -4.93690554    -1.87127171    -4.93690554
  C    -8.00253937    -4.93690554    -4.93690554
  C    -4.93690554    -4.93690554    -1.87127171
  C    -4.93690554    -4.93690554    -8.00253937
  N    -3.04160699    -4.93690554    -4.93690554
  N    -4.93690554    -6.83220409    -4.93690554
  N    -4.93690554    -3.04160699    -4.93690554
  N    -6.83220409    -4.93690554    -4.93690554
  N    -4.93690554    -4.93690554    -3.04160699
  N    -4.93690554    -4.93690554    -6.83220409
K_POINTS automatic
  3 3 3 0 0 0
HUBBARD {atomic}
  U Mn-3d 3.9
  U Fe-3d 5.3
