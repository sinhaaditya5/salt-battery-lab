&CONTROL
  calculation = 'vc-relax'
  prefix = 'LiFePO4'
  outdir = './tmp'
  pseudo_dir = '/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 150
  disk_io = 'low'
  max_seconds = 160000
/
&SYSTEM
  ibrav = 0
  nat = 28
  ntyp = 4
  ecutwfc = 40.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 2
  starting_magnetization(1) = 0.0
  starting_magnetization(2) = 0.8
  starting_magnetization(3) = 0.0
  starting_magnetization(4) = 0.0
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.3
  electron_maxstep = 250
  mixing_mode = 'plain'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
ATOMIC_SPECIES
  Li 6.94 li_pbe_v1.4.uspp.F.UPF
  Fe 55.845 fe_pbe_v1.5.uspp.F.UPF
  P 30.974 p_pbe_v1.5.uspp.F.UPF
  O 15.999 o_pbe_v1.2.uspp.F.UPF
