&control
  calculation='scf', prefix='NiCl2_FM', outdir='./tmp',
  pseudo_dir='/Volumes/Aditya ssd/Salt-Battery-Lab/tools/pseudo/gbrv', tprnfor=.true., tstress=.true.,
  etot_conv_thr=1e-5, forc_conv_thr=1e-4, disk_io='low'
/
&system
  ibrav=0, nat=3, ntyp=2,
  ecutwfc=60, ecutrho=480, vdw_corr='dft-d3', dftd3_version=4,
  occupations='smearing', smearing='mv', degauss=0.01,
  nspin=2,
  starting_magnetization(1)=0.4,
/
&electrons
  conv_thr=1e-08, mixing_beta=0.3, electron_maxstep=200
/
ATOMIC_SPECIES
Ni 58.693 ni_pbe_v1.4.uspp.F.UPF
Cl 35.453 cl_pbe_v1.4.uspp.F.UPF
HUBBARD (ortho-atomic)
U Ni-3d 4.00
CELL_PARAMETERS angstrom
  1.77150000 1.02277600 5.77833333
  -1.77150000 1.02277600 5.77833333
  0.00000000 -2.04555200 5.77833333
ATOMIC_POSITIONS crystal
Ni 0.00000000 0.00000000 0.00000000
Cl 0.25570000 0.25570000 0.25570000
Cl -0.25570000 -0.25570000 -0.25570000
K_POINTS automatic
5 5 5 0 0 0
