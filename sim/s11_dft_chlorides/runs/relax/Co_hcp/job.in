&control
  calculation='vc-relax', prefix='Co_hcp', outdir='./tmp',
  pseudo_dir='/Volumes/Aditya ssd/Salt-Battery-Lab/tools/pseudo/gbrv', tprnfor=.true., tstress=.true.,
  etot_conv_thr=1e-5, forc_conv_thr=1e-4, disk_io='low'
/
&system
  ibrav=0, nat=2, ntyp=1,
  ecutwfc=50, ecutrho=400, vdw_corr='dft-d3', dftd3_version=4,
  occupations='smearing', smearing='mv', degauss=0.01,
  nspin=2,
  starting_magnetization(1)=0.5,
/
&electrons
  conv_thr=1e-08, mixing_beta=0.3, electron_maxstep=200
/
&ions
  ion_dynamics='bfgs'
/
&cell
  cell_dynamics='bfgs', press_conv_thr=0.5
/
ATOMIC_SPECIES
Co 58.933 co_pbe_v1.2.uspp.F.UPF
CELL_PARAMETERS angstrom
  2.50700000 0.00000000 0.00000000
  -1.25350000 2.17112569 0.00000000
  0.00000000 0.00000000 4.07000000
ATOMIC_POSITIONS crystal
Co 0.33333333 0.66666667 0.25000000
Co 0.66666667 0.33333333 0.75000000
K_POINTS automatic
19 19 10 0 0 0
