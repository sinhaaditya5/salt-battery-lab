&control
  calculation='vc-relax', prefix='FeCl2', outdir='./tmp',
  pseudo_dir='/Volumes/Aditya ssd/Salt-Battery-Lab/tools/pseudo/gbrv', tprnfor=.true., tstress=.true.,
  etot_conv_thr=1e-5, forc_conv_thr=1e-4, disk_io='low'
/
&system
  ibrav=0, nat=3, ntyp=2,
  ecutwfc=50, ecutrho=400, vdw_corr='dft-d3', dftd3_version=4,
  occupations='smearing', smearing='mv', degauss=0.01,
  nspin=2,
  starting_magnetization(1)=0.6,
/
&electrons
  conv_thr=1e-07, mixing_beta=0.3, electron_maxstep=200
/
&ions
  ion_dynamics='bfgs'
/
&cell
  cell_dynamics='bfgs', press_conv_thr=0.5
/
ATOMIC_SPECIES
Fe 55.845 fe_pbe_v1.5.uspp.F.UPF
Cl 35.453 cl_pbe_v1.4.uspp.F.UPF
HUBBARD (ortho-atomic)
U Fe-3d 4.00
CELL_PARAMETERS angstrom
  1.78950000 1.03316831 5.84533333
  -1.78950000 1.03316831 5.84533333
  0.00000000 -2.06633661 5.84533333
ATOMIC_POSITIONS crystal
Fe 0.00000000 0.00000000 0.00000000
Cl 0.25760000 0.25760000 0.25760000
Cl -0.25760000 -0.25760000 -0.25760000
K_POINTS automatic
5 5 5 0 0 0
